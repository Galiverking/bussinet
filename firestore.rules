rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Jobs collection - with data validation
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['customerName', 'status', 'createdAt'])
        && request.resource.data.status in ['pending', 'done']
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100;
      allow update: if request.resource.data.keys().hasAll(['customerName', 'status'])
        && request.resource.data.status in ['pending', 'done'];
      allow delete: if true;
    }
    
    // Expenses collection - with data validation
    match /expenses/{expenseId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'amount', 'createdAt', 'date'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 1000000;
      allow update: if request.resource.data.keys().hasAll(['name', 'amount'])
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0;
      allow delete: if true;
    }
    
    // Legacy path support (optional - for future auth)
    match /users/{userId}/{document=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}